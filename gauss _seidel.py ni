x = 0
y = 0
z = 0

# Number of iterations
n = 10

print("Gauss Seidel Method")
print("-------------------")

for i in range(n):
    x = (7 - 2*y - z) / 10
    y = (-8 - x - z) / 5
    z = (6 - 2*x - 3*y) / 10

    print("Iteration", i + 1)
    print("x =", x)
    print("y =", y)
    print("z =", z)

print("\nFinal Solution:")
print("x =", x)
print("y =", y)
print("z =", z)
